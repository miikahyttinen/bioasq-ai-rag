# Copy to .env and override any setting from backend/app/config.py.
# Variable names are case-insensitive.

OLLAMA_HOST=http://localhost:11434

# Main chat model (Gemma 4 26B A4B, QAT 4-bit, ~15.6 GB).
CHAT_MODEL=gemma4:26b-a4b-it-qat
# Switch CHAT_MODEL to this if memory pressure turns yellow/red (~7.2 GB).
FALLBACK_CHAT_MODEL=gemma4:12b-it-qat

EMBED_MODEL=qwen3-embedding:0.6b
NUM_CTX=8192
# Gemma 4 reasons before answering when enabled (better on hard questions, ~10x slower).
CHAT_THINK=false

# Chunking
CHUNK_CHARS=1200
CHUNK_OVERLAP_CHARS=200
MAX_WHOLE_PASSAGE_CHARS=2000

# Retrieval
DEFAULT_K=8

# Answer evaluation
EVAL_SAMPLE_SIZE=100
EVAL_SEED=42
